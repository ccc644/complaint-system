# 统一换行符，避免 Windows / Linux 混用导致整文件 diff
* text=auto

*.py     text eol=lf
*.ts     text eol=lf
*.js     text eol=lf
*.vue    text eol=lf
*.css    text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.jsonl  text eol=lf
*.txt    text eol=lf
*.bat    text eol=crlf

*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.svg    text eol=lf

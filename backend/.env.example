# ============================================================
# Complaint System v3.0 — 环境配置
# ============================================================
# 使用方法：复制此文件并重命名为 .env，填入实际值
#   cp .env.example .env    (Linux / macOS)
#   copy .env.example .env   (Windows)
# ============================================================

# DeepSeek API — 必填
DEEPSEEK_API_KEY=sk-your-api-key-here

# SMTP 邮件配置 — 选填（不填则邮件功能降级为仅生成草稿）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=your-email@example.com

# PostgreSQL 数据库连接 — 必填（SQLite → PG 迁移后使用）
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# 钉钉企业内部应用（工作通知）— 选填（系统设置界面 DB 配置优先，此处兜底）
# DINGTALK_APP_KEY=dingxxxxxxxxxxxxxxxx
# DINGTALK_APP_SECRET=your-app-secret
# DINGTALK_AGENT_ID=123456789
# 系统对外访问地址（钉钉卡片跳转链接前缀，不含末尾斜杠，如 http://192.168.1.10:8506）
# PUBLIC_BASE_URL=http://your-server-ip:8506
# 调试模式：跳过真实钉钉 HTTP 调用，仅记录发送日志
# DINGTALK_DRY_RUN=1

# ── 0908 RAG 阶段 1：向量 embedding（混合检索）──
# 硅基流动（OpenAI 兼容），key 注册获取后填入；不填则检索以纯关键词模式运行
EMBEDDING_PROVIDER=api
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3
# EMBEDDING_LOCAL_MODEL=        # 本地模型（离线内网部署预留，本期未实现）
